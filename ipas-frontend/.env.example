# IPAS Frontend Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file with real credentials!

# CRITICAL: Azure OpenAI Configuration
REACT_APP_AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
REACT_APP_AZURE_OPENAI_DEPLOYMENT=gpt-4
REACT_APP_AZURE_OPENAI_KEY=your-azure-openai-api-key-here
REACT_APP_AZURE_API_VERSION=2024-02-15-preview
